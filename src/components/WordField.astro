---
import { wordChips } from '../data/content';

// Детермінований «хаос»: значення однакові на сервері й у браузері.
const rand = (i: number, seed: number) => {
  const v = Math.sin((i + 1) * seed) * 10000;
  return ((v % 1) + 1) % 1;
};

const chips = wordChips.map((chip, i) => ({
  ...chip,
  // Амплітуда стримана: картки мають лишатися в межах колонки навіть у хаосі
  dx: Math.round((rand(i, 12.9898) - 0.5) * 150),
  dy: Math.round((rand(i, 78.233) - 0.5) * 130),
  dr: Math.round((rand(i, 43.758) - 0.5) * 26),
}));
---

<div class="field" data-word-field>
  <div class="field__grid">
    {
      chips.map((chip) => (
        <article
          class="chip"
          data-chip
          data-dx={chip.dx}
          data-dy={chip.dy}
          data-dr={chip.dr}
          data-article={chip.article ?? 'verb'}
        >
          <span class="chip__tag">{chip.article ?? 'Verb'}</span>
          <span class="chip__word">{chip.word.replace(/^(der|die|das)\s/, '')}</span>
          <span class="chip__uk">{chip.uk}</span>
        </article>
      ))
    }
  </div>

</div>

<style>
  .field {
    position: relative;
  }

  .field__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .chip {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.85rem;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgb(20 30 25 / 0.07);
    border-left: 3px solid var(--chip-color);
    box-shadow: 0 10px 24px -20px rgb(20 30 25 / 0.55);
    will-change: transform;
  }

  .chip[data-article='der'] {
    --chip-color: var(--color-forest);
  }
  .chip[data-article='die'] {
    --chip-color: var(--color-coral);
  }
  .chip[data-article='das'] {
    --chip-color: var(--color-gold);
  }
  .chip[data-article='verb'] {
    --chip-color: var(--color-ink);
  }

  .chip__tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--chip-color);
  }

  .chip__word {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .chip__uk {
    font-size: 0.72rem;
    color: rgb(20 30 25 / 0.55);
    line-height: 1.3;
  }

  @media (min-width: 560px) {
    .field__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .chip__word {
      font-size: 1rem;
    }
  }
</style>
