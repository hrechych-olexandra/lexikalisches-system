---
import { hero } from '../data/content';
import CtaButton from './CtaButton.astro';
import WordField from './WordField.astro';
---

<section class="hero" id="top">
  <div class="shell">
    <p class="eyebrow hero__eyebrow" data-reveal>{hero.eyebrow}</p>

    <h1 class="hero__title">
      <span class="hero__line" data-reveal-line>{hero.title}</span>
      <span class="hero__line hero__line--accent" data-reveal-line>{hero.titleAccent}</span>
    </h1>

    <div class="hero__body">
      <div class="hero__loop" data-reveal>
        <ol class="loop">
          {
            hero.loop.map((step) => (
              <li class="loop__step">
                <span class="loop__marker" aria-hidden="true" />
                {step}
              </li>
            ))
          }
        </ol>

        <p class="hero__hook" data-reveal>{hero.hook}</p>
      </div>

      <div class="hero__visual">
        <img
          class="hero__photo"
          src={hero.photo}
          alt={hero.photoAlt}
          fetchpriority="high"
          decoding="async"
          data-reveal
        />
        <div class="hero__field" data-reveal>
          <WordField />
        </div>
      </div>
    </div>

    <div class="hero__close">
      <p class="hero__answer" data-reveal>{hero.answer}</p>
      <p class="hero__lead" data-reveal>
        {hero.lead.before}<strong>{hero.lead.strong}</strong>{hero.lead.after}
      </p>
      <div data-reveal>
        <CtaButton label={hero.cta} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(7rem, 14vw, 11rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    position: relative;
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 55vw;
    height: 55vw;
    max-width: 700px;
    max-height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(229 228 200 / 0.55), transparent 68%);
    pointer-events: none;
    z-index: -1;
  }

  .hero__eyebrow {
    color: var(--color-forest);
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: var(--text-hero);
    display: flex;
    flex-direction: column;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero__line {
    display: block;
  }

  .hero__line--accent {
    color: var(--color-forest);
    font-style: italic;
    font-weight: 400;
  }

  .hero__body {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .hero__loop {
    position: relative;
  }

  .loop {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    list-style: none;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: rgb(20 30 25 / 0.8);
  }

  .loop__step {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .loop__marker {
    flex: none;
    width: 18px;
    height: 1px;
    background: var(--color-forest);
    translate: 0 -0.3em;
  }

  .loop__step:last-child {
    color: var(--color-coral);
    font-weight: 600;
  }

  .loop__step:last-child .loop__marker {
    background: var(--color-coral);
  }

  .hero__hook {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-coral);
  }

  .hero__visual {
    position: relative;
  }

  .hero__photo {
    display: block;
    width: 72%;
    max-width: 300px;
    margin: 0 auto 1.5rem;
  }

  .hero__field {
    position: relative;
    z-index: 1;
  }

  .hero__close {
    margin-top: clamp(3rem, 6vw, 5rem);
    max-width: 44rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .hero__answer {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .hero__lead {
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    color: rgb(20 30 25 / 0.78);
  }

  .hero__lead strong {
    font-weight: 600;
    color: var(--color-ink);
    box-shadow: inset 0 -0.55em 0 rgb(227 207 130 / 0.5);
  }

  .hero__close :global(.btn) {
    margin-top: 0.9rem;
  }

  @media (min-width: 900px) {
    .hero__body {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 4rem;
    }

    /* Фото стоїть шаром позаду, картки зі словами лягають поверх нього */
    .hero__photo {
      position: absolute;
      right: -3rem;
      bottom: -1rem;
      width: 68%;
      max-width: none;
      margin: 0;
      z-index: 0;
    }
  }
</style>
