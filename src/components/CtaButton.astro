---
import { payUrl } from '../data/content';

interface Props {
  label: string;
  class?: string;
  variant?: 'coral' | 'cream';
}

const { label, class: cls = '', variant = 'coral' } = Astro.props;
---

<a
  href={payUrl}
  target="_blank"
  rel="noopener"
  class:list={['btn', variant === 'cream' && 'btn--cream', cls]}
  data-magnetic
>
  <span>{label}</span>
  <svg class="btn-arrow" width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
    <path
      d="M1 6h15m0 0-5-5m5 5-5 5"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .btn--cream {
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .btn--cream::before {
    background: var(--color-gold);
  }

  .btn--cream:hover {
    box-shadow: 0 18px 40px -18px rgb(254 249 238 / 0.6);
  }
</style>
