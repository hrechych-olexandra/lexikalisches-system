---
import { footer, socials } from '../data/content';

const items = [
  {
    label: 'Instagram',
    href: socials.instagram,
    handle: '@oleksandra.hrechych',
    icon: 'instagram',
  },
  {
    label: 'YouTube',
    href: socials.youtube,
    handle: 'Німецька з Олександрою Гречич',
    icon: 'youtube',
  },
  { label: 'Email', href: `mailto:${socials.email}`, handle: socials.email, icon: 'email' },
];
---

<footer class="footer">
  <div class="shell footer__inner">
    <h2 class="footer__title">{footer.title}</h2>

    <ul class="footer__list">
      {
        items.map((item) => (
          <li>
            <a
              class="footer__link"
              href={item.href}
              target={item.href.startsWith('mailto:') ? undefined : '_blank'}
              rel="noopener"
            >
              <span class="footer__icon" aria-hidden="true">
                {item.icon === 'instagram' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="3" width="18" height="18" rx="5.2" />
                    <circle cx="12" cy="12" r="4.1" />
                    <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {item.icon === 'youtube' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="2" y="5" width="20" height="14" rx="4.6" />
                    <path d="M10.3 9.2v5.6l4.9-2.8z" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {item.icon === 'email' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="2.5" y="5" width="19" height="14" rx="3.2" />
                    <path
                      d="m3.7 7.4 8.3 5.8 8.3-5.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </span>

              <span class="footer__label">{item.label}</span>
              <span class="footer__handle">{item.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="footer__legal">
      © {new Date().getFullYear()} Олександра Гречич. Усі права захищено.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-cream);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .footer__title {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    margin-bottom: 2.5rem;
  }

  .footer__list {
    display: grid;
    gap: 0;
    list-style: none;
    border-top: 1px solid rgb(254 249 238 / 0.16);
  }

  .footer__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem 1rem;
    padding-block: 1.15rem;
    border-bottom: 1px solid rgb(254 249 238 / 0.16);
    color: inherit;
    text-decoration: none;
    transition: padding-inline 0.4s var(--ease-out-soft);
  }

  .footer__link:hover {
    padding-inline: 0.75rem;
    background: rgb(254 249 238 / 0.04);
  }

  .footer__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgb(254 249 238 / 0.22);
    color: var(--color-gold);
    transition:
      background-color 0.4s var(--ease-out-soft),
      color 0.4s var(--ease-out-soft),
      transform 0.4s var(--ease-out-soft);
  }

  .footer__icon svg {
    width: 20px;
    height: 20px;
  }

  .footer__link:hover .footer__icon {
    background: var(--color-gold);
    color: var(--color-ink);
    transform: scale(1.06);
  }

  .footer__label {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    align-self: end;
  }

  .footer__handle {
    font-size: 0.85rem;
    color: rgb(254 249 238 / 0.6);
    align-self: start;
  }

  .footer__legal {
    margin-top: 2.5rem;
    font-size: 0.76rem;
    color: rgb(254 249 238 / 0.45);
  }

  @media (min-width: 700px) {
    .footer__link {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
    }

    .footer__icon {
      grid-row: auto;
    }

    .footer__handle {
      align-self: center;
      text-align: right;
    }
  }
</style>
