---
import CtaButton from './CtaButton.astro';

const links = [
  { href: '#program', label: 'Програма' },
  { href: '#format', label: 'Формат' },
  { href: '#reviews', label: 'Відгуки' },
  { href: '#faq', label: 'Питання' },
];
---

<header class="nav" data-nav>
  <div class="shell nav__inner">
    <a href="#top" class="nav__brand">
      Олександра&nbsp;Гречич
      <span class="nav__brand-sub">німецька мова</span>
    </a>

    <nav class="nav__links" aria-label="Розділи сторінки">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <CtaButton label="Отримати" class="nav__cta" />
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    transition:
      background-color 0.45s var(--ease-out-soft),
      box-shadow 0.45s var(--ease-out-soft),
      backdrop-filter 0.45s var(--ease-out-soft);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.1rem;
  }

  .nav__brand {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .nav__brand-sub {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-forest);
  }

  .nav__links {
    display: none;
    gap: 2rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav__links a {
    position: relative;
    color: var(--color-ink);
    text-decoration: none;
    padding-block: 0.25rem;
  }

  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-coral);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out-soft);
  }

  .nav__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__cta {
    padding: 0.7rem 1.4rem;
    font-size: 0.72rem;
  }

  :global(.nav.is-stuck) {
    background: rgb(254 249 238 / 0.82);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(20 30 25 / 0.08);
  }

  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }
  }
</style>
