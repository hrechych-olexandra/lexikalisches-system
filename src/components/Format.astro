---
import { formatSection } from '../data/content';
---

<section class="format band" id="format">
  <div class="shell">
    <h2 class="format__title" data-reveal>{formatSection.title}</h2>

    <ol class="format__list">
      {
        formatSection.items.map((item, i) => (
          <li class="stage" data-reveal>
            <span class="stage__num">{i + 1}</span>
            <h3 class="stage__title">{item.title}</h3>
            <p class="stage__text">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .format {
    background: var(--color-forest-deep);
    color: var(--color-cream);
  }

  .format__title {
    font-size: var(--text-section);
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .format__list {
    display: grid;
    gap: 2.5rem;
    list-style: none;
    counter-reset: stage;
  }

  .stage {
    position: relative;
    padding-top: 3.75rem;
  }

  .stage__num {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(229 228 200 / 0.4);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-gold);
  }

  .stage__title {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    margin-bottom: 0.7rem;
  }

  .stage__text {
    font-size: 0.95rem;
    color: rgb(254 249 238 / 0.72);
  }

  @media (min-width: 860px) {
    .format__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem;
    }

    /* Лінія, що з'єднує етапи в послідовність */
    .stage:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 22px;
      left: 56px;
      right: -3rem;
      height: 1px;
      background: repeating-linear-gradient(
        to right,
        rgb(229 228 200 / 0.4) 0 4px,
        transparent 4px 9px
      );
    }
  }
</style>
