---
import { aboutSection } from '../data/content';
---

<section class="about band" id="about">
  <div class="shell about__inner">
    <div class="about__media" data-reveal>
      <img
        src={aboutSection.photo}
        alt={aboutSection.photoAlt}
        loading="lazy"
        decoding="async"
        data-parallax
      />
      <span class="about__stamp" aria-hidden="true">A1&nbsp;–&nbsp;C1</span>
    </div>

    <div class="about__body">
      <h2 class="about__title" data-reveal>{aboutSection.title}</h2>
      <p class="about__name" data-reveal>{aboutSection.name}</p>

      {aboutSection.paragraphs.map((p) => <p class="about__p" data-reveal>{p}</p>)}

      <dl class="facts" data-reveal>
        {
          aboutSection.facts.map((f) => (
            <div class="fact">
              <dt class="fact__value">{f.value}</dt>
              <dd class="fact__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .about__media {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-sand);
    aspect-ratio: 4 / 5;
  }

  .about__media img {
    width: 100%;
    height: 110%;
    object-fit: cover;
    display: block;
    will-change: transform;
  }

  .about__stamp {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgb(254 249 238 / 0.9);
    backdrop-filter: blur(8px);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .about__title {
    font-size: var(--text-section);
    margin-bottom: 1.5rem;
  }

  .about__name {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-forest);
    margin-bottom: 1.25rem;
  }

  .about__p {
    font-size: clamp(0.98rem, 1.4vw, 1.06rem);
    color: rgb(20 30 25 / 0.75);
    margin-bottom: 1rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(20 30 25 / 0.12);
  }

  .fact__value {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-forest);
    line-height: 1.1;
  }

  .fact__label {
    font-size: 0.76rem;
    color: rgb(20 30 25 / 0.55);
    margin-top: 0.35rem;
    line-height: 1.35;
  }

  @media (min-width: 900px) {
    .about__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 4.5rem;
    }

    .about__media {
      position: sticky;
      top: 7rem;
    }
  }
</style>
